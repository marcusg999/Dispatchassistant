# Copy to .env for local development. NEVER commit real values.
# In production these live ONLY in Netlify → Site configuration → Environment variables.

# Secret path segment for the portal: https://<site>/s/<PORTAL_KEY>
# Generate: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
PORTAL_KEY=

# Server-side (Netlify Functions only). The secret key bypasses RLS: never expose it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin console (bundled into the admin entry; publishable key is safe to ship, RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to "false" to disable the daily keep-alive (e.g. on a paid Supabase plan).
KEEP_ALIVE_ENABLED=

# Optional abuse protection (off by default). See README → "Turn on Cloudflare Turnstile".
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
