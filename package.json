{
  "name": "dispatch-bro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite -c vite.portal.config.ts",
    "dev:admin": "vite -c vite.admin.config.ts",
    "build": "npm run build:portal && npm run build:admin && node scripts/postbuild.mjs",
    "build:portal": "vite build -c vite.portal.config.ts",
    "build:admin": "vite build -c vite.admin.config.ts",
    "check:secrets": "node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test --trace off",
    "db:types": "supabase gen types typescript --local > src/shared/database.types.ts && prettier --write src/shared/database.types.ts",
    "flyer": "node scripts/flyer.mjs",
    "test:db": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "^2.119.1",
    "docx": "^9.15.4",
    "exceljs": "^4.4.0",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
